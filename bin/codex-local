#!/usr/bin/env bash
# Usage: codex-local [fast|lite|medium|coder|smart|long] [codex args...]
# OpenAI Codex CLI against llama-server's Responses API (/v1/responses).
# Provider is passed with -c overrides only; ~/.codex/config.toml is not modified.
set -euo pipefail
P="${1:-fast}"; shift || true
. "$(dirname "$0")/_common.sh" "$P"

exec "$ROOT/tools/node_modules/.bin/codex" \
  -c model_provider=local-llm \
  -c "model_providers.local-llm={name=\"Local llama.cpp\", base_url=\"$LOCAL_LLM_V1\", env_key=\"LOCAL_LLM_API_KEY\", wire_api=\"responses\"}" \
  -c model_context_window=$CTX -c model_auto_compact_token_limit=$MAX_PROMPT \
  -m "$ALIAS" "$@"

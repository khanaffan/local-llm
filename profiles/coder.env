# Qwen3.8-Flash-Next (125B, 6B active + 51B n-gram embeddings), unsloth UD-IQ3_XXS, 3 shards.
MODEL_FILE=models/Qwen3.8-Flash-Next-UD-IQ3_XXS-00001-of-00003.gguf
ALIAS=local-coder
CTX=131072
CACHE_K=f16
CACHE_V=f16
# GGUF chat template (unsloth) with one patch: system messages after the first turn are rendered
# instead of raising "System message must be at the beginning" (Claude Code sends them).
CHAT_TEMPLATE=templates/qwen3.8-flash-next.jinja
# Qwen3.8 card, thinking mode. The template defaults to xhigh effort, which often ran past the
# 8192-token output cap in tests; medium keeps answers within budget (also: low, xhigh).
EXTRA_ARGS="--temp 1.0 --top-p 0.95 --top-k 20 --min-p 0 --reasoning-effort medium"
# Setup guidance: smallest Mac RAM size that runs this profile at CTX with OS headroom
# (from measured server RSS: see README). Lower CTX in profiles/coder.local.env if needed.
MIN_RAM_GB=128
DESC="Qwen3.8-Flash-Next – strongest coder (agentic SWE)"

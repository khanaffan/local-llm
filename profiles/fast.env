MODEL_FILE=models/gpt-oss-20b-MXFP4.gguf
ALIAS=local-fast
CTX=131072
CACHE_K=f16
CACHE_V=f16
# gpt-oss card: temperature 1.0, top_p 1.0, top_k 0
EXTRA_ARGS="--temp 1.0 --top-p 1.0 --top-k 0 --min-p 0 --reasoning-effort medium"
# Setup guidance: smallest Mac RAM size that runs this profile at CTX with OS headroom
# (from measured server RSS: see README). Lower CTX in profiles/fast.local.env if needed.
MIN_RAM_GB=24
DESC="gpt-oss-20b – quickest, small memory (~15 GiB at 128k)"

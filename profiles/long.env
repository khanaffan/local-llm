# Same weights as medium, at the model's full native context (262144).
# Tested: 239k-token prompt, 3/3 needle recall, 48 GiB RSS, no swap; cold prefill ~22 min.
MODEL_FILE=models/Qwen3-Coder-30B-A3B-Instruct-Q6_K.gguf
ALIAS=local-long
CTX=262144
CACHE_K=f16
CACHE_V=f16
# Qwen3-Coder card sampling
EXTRA_ARGS="--temp 0.7 --top-p 0.8 --top-k 20 --repeat-penalty 1.05"
# Setup guidance: smallest Mac RAM size that runs this profile at CTX with OS headroom
# (from measured server RSS: see README). Lower CTX in profiles/long.local.env if needed.
MIN_RAM_GB=64
DESC="Qwen3-Coder-30B-A3B at 256k context (~48 GiB at 239k)"
